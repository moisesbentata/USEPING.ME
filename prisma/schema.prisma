generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                   String     @id @default(cuid())
  phone                String     @unique
  name                 String?
  timezone             String?
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?    // active | past_due | canceled | trialing
  createdAt            DateTime   @default(now())
  memories             Memory[]
  reminders            Reminder[]
  messages             Message[]
  contacts             Contact[]
}

model Contact {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  name      String
  phone     String
  createdAt DateTime   @default(now())
  reminders Reminder[]

  @@unique([ownerId, phone])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model Memory {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  content   String
  embedding Unsupported("vector(512)")?
  createdAt DateTime               @default(now())
}

model Reminder {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  message           String
  dueAt             DateTime
  status            String    @default("pending") // pending | sent | cancelled
  recurrenceRule    String? // RFC5545 RRULE part only, e.g. "FREQ=WEEKLY;BYDAY=TU"
  recurrenceDtstart DateTime? // anchor date for computing recurrence occurrences
  groupId           String? // links related reminders (e.g. a lead-up sequence) so list/cancel treat them as one
  contactId         String? // if set, this reminder is sent to the contact's phone, not the owner's
  contact           Contact?  @relation(fields: [contactId], references: [id])
  createdAt         DateTime  @default(now())
}
